# Dependencies
# Both forms, deliberately: the trailing slash matches a directory and not a *symlink* of the same
# name, and a symlinked node_modules is exactly what you get when running the suite from a git
# worktree — `ln -s ../../node_modules` is the only way to avoid a per-worktree `npm ci`. Under the
# slash-only pattern a `git add -A` in such a worktree stages the link itself, which is how one got
# committed during the #64-#81 sweep.
node_modules/
node_modules

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Test & coverage
coverage/
playwright-report/
test-results/
.playwright/

# Environment
.env
.env.*
!.env.example

# Claude Code local overrides
.claude/settings.local.json

# Editor / OS cruft
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
